# このファイルを .env に写して、＜＞の中を書き換えてください。
#   cp .env.example .env
# .env は Git に入れないでください（.gitignore で除外しています）。

TZ=Asia/Tokyo
# サーバーで `id -u` `id -g` を打って出た数字
PUID=1000
PGID=1000

# --- Paperless-ngx ---
# 長いでたらめな文字列。例：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PAPERLESS_SECRET_KEY=＜でたらめな長い文字列＞
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=＜管理者のパスワード＞
# スマホから Paperless を開くときの URL（お知らせの「原本を開く」に使う）
PAPERLESS_PUBLIC_URL=http://＜サーバーの IP＞:8000
# 初回の起動のあと、scripts/get_token.py で作って書き込む
PAPERLESS_API_TOKEN=

# --- AI（名付け・分類と、予定の取り出し） ---
# Google AI Studio で作る API キー。課金を有効にした契約で使う（無料枠は送った内容が改善に使われる。7 章）
GEMINI_API_KEY=＜Gemini の API キー＞
# モデル名は変わるので、使う前に Google の案内で今のモデル名を確かめる
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# --- 通知（Pushover） ---
# 空のままなら、送らずに画面に出すだけ（試すとき用）
PUSHOVER_TOKEN=
# 送り先のユーザーキー。夫婦で送るならカンマで区切る
PUSHOVER_USERS=
